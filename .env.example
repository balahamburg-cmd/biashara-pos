# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used to add staff accounts and to record M-Pesa callbacks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# M-Pesa Daraja (developer.safaricom.co.ke). Leave blank to turn automatic M-Pesa off.
MPESA_ENV=sandbox            # sandbox or production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379       # your Till / Paybill (Business Short Code)
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline   # CustomerPayBillOnline for Paybill
MPESA_PARTY_B=               # Till number for Buy Goods; leave blank for Paybill (uses shortcode)
# Public URL of this app, used for the M-Pesa callback, e.g. https://biashara-pos.vercel.app
APP_URL=
